# ---------------------------------------------------------------------------
# Branding
#
# Everything the site renders about the studio comes from src/config/brand.ts.
# These variables override the parts that change per deployment, so one build
# can serve a different studio without touching source.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STUDIO_NAME="Pulse Studios"
NEXT_PUBLIC_STUDIO_LEGAL_NAME="Pulse Studios Ltd."
NEXT_PUBLIC_STUDIO_TAGLINE="Where Sound Becomes Emotion."
NEXT_PUBLIC_STUDIO_EMAIL="bookings@pulsestudios.com"
NEXT_PUBLIC_STUDIO_PHONE="+1 (212) 555-0180"
# Path in /public — leave empty to use the drawn SVG mark.
NEXT_PUBLIC_STUDIO_LOGO=""

# Canonical origin. Used for sitemap URLs, Open Graph tags and structured data,
# so it must be the real public origin in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Integrations
#
# The site runs fully without any of these — bookings, contact and newsletter
# submissions fall back to an in-memory store and are logged instead of sent.
# Fill them in to wire the real services.
# ---------------------------------------------------------------------------

# Payments (deposits at booking, beat and merch checkout)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Database — bookings, orders, client accounts
DATABASE_URL="postgresql://studio:studio@localhost:5432/studio"

# Transactional email (booking confirmations, contact replies)
SMTP_URL=""
MAIL_FROM="Pulse Studios <bookings@pulsestudios.com>"

# SMS confirmations
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Media hosting for the gallery, room tours and track artwork
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Maps embed on the contact page
NEXT_PUBLIC_MAPS_EMBED_KEY=""

# Analytics — omit to disable; no third-party script loads without it
NEXT_PUBLIC_ANALYTICS_ID=""
